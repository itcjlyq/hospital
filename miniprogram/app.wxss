/* ============================================================
   肝健康助手 · 全局设计系统（Clean Medical Wellness）
   主色 #13A89E / 深青 #087F78 / 标题 #183B4A / 正文 #344054
   背景 #F5F8FA / 卡片 #FFFFFF / 浅青 #E8F7F4 / 浅蓝 #EAF3FA
   圆角 24~36rpx · 轻阴影 · 细腻分割线 #E8EDF0
   ============================================================ */
@import "./styles/icons.wxss";

page {
  /* 设计令牌（如需取值请直接引用变量；旧机型自动回退到硬编码色值） */
  --brand: #13A89E;
  --brand-deep: #087F78;
  --brand-soft: #E8F7F4;
  --blue-soft: #EAF3FA;
  --title: #183B4A;
  --text: #344054;
  --text-2: #84929F;
  --bg: #F5F8FA;
  --card: #FFFFFF;
  --line: #E8EDF0;
  --warn: #C98A2B;
  --danger: #D6453B;

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #344054;
  background-color: #F5F8FA;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, button, scroll-view, picker, switch {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 60rpx;
}

/* 自定义 tabBar 占位（tab 页面使用） */
.has-tabbar {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(24, 59, 74, 0.05);
}

/* ---------- 标题层级 ---------- */
.h-display { font-size: 44rpx; font-weight: 700; color: #183B4A; line-height: 1.3; }
.h1 { font-size: 36rpx; font-weight: 600; color: #183B4A; line-height: 1.4; }
.h2 { font-size: 32rpx; font-weight: 600; color: #183B4A; line-height: 1.4; }
.h3 { font-size: 28rpx; font-weight: 600; color: #183B4A; }
.text-body { font-size: 28rpx; color: #344054; line-height: 1.65; }
.text-caption { font-size: 24rpx; color: #84929F; line-height: 1.5; }
.text-mini { font-size: 22rpx; color: #84929F; }

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 6rpx 20rpx;
}
.section-head .st-title { font-size: 31rpx; font-weight: 600; color: #183B4A; }
.section-head .st-action { font-size: 24rpx; color: #13A89E; }

/* ---------- 按钮 ---------- */
.btn-primary {
  background: #13A89E;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 31rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  box-shadow: 0 12rpx 28rpx rgba(19, 168, 158, 0.24);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-primary.button-hover { opacity: 0.88; transform: scale(0.985); }
.btn-primary::after { border: none; }

.btn-ghost {
  background: #EDF4F3;
  color: #16655F;
  border-radius: 999rpx;
  font-size: 29rpx;
}
.btn-ghost::after { border: none; }

.btn-danger-ghost {
  background: #FFFFFF;
  color: #D6453B;
  border-radius: 999rpx;
  font-size: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(24, 59, 74, 0.05);
}
.btn-danger-ghost::after { border: none; }

/* 固定在底部的操作条 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -6rpx 24rpx rgba(24, 59, 74, 0.06);
  z-index: 50;
}
.footer-bar .btn-primary { margin: 0; }
.footer-holder { height: calc(150rpx + env(safe-area-inset-bottom)); }

/* ---------- 标签/胶囊 ---------- */
.chip {
  display: inline-block;
  padding: 9rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #E8F7F4;
  color: #0B7F76;
}
.chip-blue { background: #EAF3FA; color: #3A6EA0; }

/* ---------- 表单 ---------- */
.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #183B4A;
  text-align: right;
  min-height: 48rpx;
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #EEF2F4;
}
.form-row:last-child { border-bottom: none; }
.form-label { font-size: 28rpx; color: #344054; width: 220rpx; flex-shrink: 0; }

/* ---------- 骨架屏 ---------- */
.skeleton {
  position: relative;
  overflow: hidden;
  background: #E9EEF1;
  border-radius: 14rpx;
}
.skeleton::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.65) 50%, rgba(255, 255, 255, 0) 100%);
  animation: sk-shimmer 1.3s infinite;
}
@keyframes sk-shimmer { 100% { transform: translateX(100%); } }

/* ---------- 空状态 / 异常状态 ---------- */
.empty-state {
  padding: 110rpx 48rpx 90rpx;
  text-align: center;
}
.empty-state .empty-ic {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #EDF2F4;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-state .empty-ic .ic { width: 60rpx; height: 60rpx; }
.empty-state .empty-title { margin-top: 28rpx; font-size: 30rpx; font-weight: 500; color: #54636E; }
.empty-state .empty-sub { margin-top: 12rpx; font-size: 24rpx; color: #84929F; line-height: 1.6; }
.empty-state .empty-btn {
  display: inline-block;
  margin-top: 34rpx;
  padding: 18rpx 52rpx;
  border-radius: 999rpx;
  background: #13A89E;
  color: #fff;
  font-size: 27rpx;
  box-shadow: 0 10rpx 24rpx rgba(19, 168, 158, 0.22);
}

.error-state { padding: 90rpx 48rpx; text-align: center; }
.error-state .err-title { font-size: 29rpx; color: #54636E; }
.error-state .err-sub { margin-top: 10rpx; font-size: 24rpx; color: #84929F; }
.error-state .err-btn {
  display: inline-block;
  margin-top: 26rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  border: 1rpx solid #13A89E;
  color: #13A89E;
  font-size: 26rpx;
}

/* ---------- 免责小字 ---------- */
.disclaimer-mini {
  text-align: center;
  font-size: 22rpx;
  color: #9DABB4;
  line-height: 1.7;
}
