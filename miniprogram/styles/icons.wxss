/* styles/icons.wxss — 统一线性图标（SVG data-uri，与设计令牌配套）
   用法：<view class="ic ic-home"></view>
   尺寸：.ic-sm 32rpx / 默认 40rpx / .ic-lg 56rpx / .ic-xl 96rpx */

.ic {
  display: inline-block;
  flex: none;
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.ic-sm { width: 32rpx; height: 32rpx; }
.ic-lg { width: 56rpx; height: 56rpx; }
.ic-xl { width: 96rpx; height: 96rpx; }

