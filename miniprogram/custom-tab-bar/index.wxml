<!-- 自定义 tabBar：首页 / 记录 / 我的 -->
<view class="tab-bar">
  <view class="tab-bar-inner">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <view class="tab-ic ic {{selected === index ? item.iconOn : item.icon}}"></view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
