@import "../styles/icons.wxss";

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -4rpx 24rpx rgba(24, 59, 74, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 9999;
}

.tab-bar-inner {
  display: flex;
  height: 108rpx;
  align-items: stretch;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab-ic {
  width: 46rpx;
  height: 46rpx;
  transition: transform 0.18s ease;
}

.tab-item.active .tab-ic {
  transform: translateY(-2rpx) scale(1.06);
}

.tab-text {
  font-size: 22rpx;
  color: #84929F;
  line-height: 1.2;
  transition: color 0.18s ease;
}

.tab-item.active .tab-text {
  color: #13A89E;
  font-weight: 600;
}
