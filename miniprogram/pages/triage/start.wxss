.page {
  padding: 24rpx 28rpx 60rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f3a36;
  margin: 12rpx 8rpx 16rpx;
}

.profile-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.profile-item {
  position: relative;
  padding: 26rpx 80rpx 26rpx 28rpx;
  border-bottom: 1rpx solid #f0f4f3;
}

.profile-item:last-child {
  border-bottom: none;
}

.profile-item.active {
  background: #f2faf8;
}

.p-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f3a36;
}

.p-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #90a09c;
}

.radio {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #c5cfcc;
}

.radio.on {
  border-color: #43A294;
  background: #43A294;
  box-shadow: inset 0 0 0 8rpx #fff;
}

.add-profile {
  padding: 24rpx 28rpx;
  color: #43A294;
  font-size: 28rpx;
  text-align: center;
  border-top: 1rpx solid #f0f4f3;
}

.complaint-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.complaint-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 22rpx;
  color: #b0bbb8;
}

.tips {
  margin-top: 22rpx;
  background: #f2faf8;
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
}

.tips-title {
  font-size: 25rpx;
  color: #2e8b7d;
  margin-bottom: 10rpx;
}

.tips-line {
  font-size: 24rpx;
  color: #6a857f;
  line-height: 1.8;
}

.submit-btn {
  margin-top: 44rpx;
  background: #43A294;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}

.submit-btn::after {
  border: none;
}

.disclaim {
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: #aab8b5;
}
