.page {
  padding: 28rpx 28rpx 60rpx;
}

.level-card {
  border-radius: 22rpx;
  padding: 40rpx 34rpx;
  color: #fff;
}

.level-low {
  background: linear-gradient(135deg, #43A294, #62bfb1);
}

.level-medium {
  background: linear-gradient(135deg, #d9a23a, #e6b95e);
}

.level-high {
  background: linear-gradient(135deg, #e2674f, #ef846f);
}

.level-emergency {
  background: linear-gradient(135deg, #c83c31, #e25a50);
}

.level-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.level-text {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.level-complaint {
  margin-top: 18rpx;
  font-size: 25rpx;
  opacity: 0.92;
  line-height: 1.6;
}

.emergency-card {
  margin-top: 24rpx;
  background: #fff1ef;
  border: 1rpx solid #f5c2bb;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
}

.em-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #c83c31;
}

.em-content {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #b23a30;
}

.call-btn {
  margin-top: 24rpx;
  background: #c83c31;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}

.call-btn::after {
  border: none;
}

.em-sub {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #c07a74;
  line-height: 1.6;
}

.sec {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
}

.sec-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f3a36;
  margin-bottom: 16rpx;
}

.sec-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bullet {
  position: relative;
  padding-left: 26rpx;
  font-size: 27rpx;
  color: #4d5d59;
  line-height: 1.6;
}

.bullet::before {
  content: '·';
  position: absolute;
  left: 8rpx;
  top: -6rpx;
  font-size: 40rpx;
  color: #43A294;
}

.sec-text {
  font-size: 27rpx;
  color: #4d5d59;
  line-height: 1.7;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  background: #e8f5f2;
  color: #2e8b7d;
  font-size: 25rpx;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
}

.chip.exam {
  background: #eef3fb;
  color: #3f6ea8;
}

.history {
  background: #f8fbfb;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
}

.h-row {
  font-size: 25rpx;
  color: #55645f;
  line-height: 1.8;
}

.h-role {
  color: #2e8b7d;
}

.disclaimer {
  margin-top: 26rpx;
  font-size: 23rpx;
  color: #98a8a4;
  line-height: 1.7;
  padding: 0 8rpx;
}

.footer-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.primary-btn {
  flex: 1;
  background: #43A294;
  color: #fff;
  border-radius: 46rpx;
  font-size: 29rpx;
}

.ghost-btn {
  flex: 1;
  background: #f2f5f4;
  color: #456;
  border-radius: 46rpx;
  font-size: 29rpx;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}
