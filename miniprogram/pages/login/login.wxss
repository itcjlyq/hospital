.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #43A294 0%, #5BB8AB 34%, #F5FBF9 62%);
  padding: 120rpx 48rpx 60rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-badge {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  color: #fff;
  font-size: 72rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-title {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.login-card {
  margin-top: 80rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 44rpx 40rpx 52rpx;
  box-shadow: 0 12rpx 40rpx rgba(67, 162, 148, 0.12);
}

.tip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.tip-text {
  margin-top: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #666;
}

.emph {
  color: #d9534f;
}

.login-btn {
  margin-top: 44rpx;
  background: #43A294;
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
  height: 92rpx;
  line-height: 92rpx;
}

.login-btn::after {
  border: none;
}

.agreement {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #bbb;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: #43A294;
  border-color: #43A294;
}

.check-mark {
  color: #fff;
  font-size: 22rpx;
  line-height: 1;
}

.agree-text {
  font-size: 24rpx;
  color: #888;
}

.link-text {
  font-size: 24rpx;
  color: #43A294;
}
