.page {
  padding: 32rpx 28rpx 60rpx;
}

.header {
  padding: 16rpx 8rpx 24rpx;
}

.hello {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f3a36;
}

.hello-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7a938e;
}

.sos-bar {
  display: flex;
  align-items: center;
  background: #fff4ec;
  border: 1rpx solid #ffd9c2;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}

.sos-icon {
  margin-right: 12rpx;
}

.sos-text {
  font-size: 24rpx;
  color: #c05a2d;
  line-height: 1.5;
}

.main-card {
  margin-top: 28rpx;
  border-radius: 24rpx;
  padding: 44rpx 36rpx;
  background: linear-gradient(135deg, #43A294 0%, #5BB8AB 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 14rpx 32rpx rgba(67, 162, 148, 0.28);
}

.main-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.main-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 25rpx;
}

.main-btn {
  background: #fff;
  color: #2e8b7d;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
}

.func-grid {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}

.func-item {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.func-icon {
  font-size: 50rpx;
}

.func-name {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.func-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #999;
}

.section-title {
  margin: 36rpx 8rpx 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f3a36;
}

.notice-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
}

.notice-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #2e8b7d;
}

.notice-content {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.65;
}

.empty-tip {
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.footer-disclaim {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #aab8b5;
}
