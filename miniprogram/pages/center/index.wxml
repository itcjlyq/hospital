<view class="page">
  <view class="user-card">
    <view class="avatar">{{userInfo.nickName ? userInfo.nickName[0] : '用'}}</view>
    <view class="user-info">
      <view class="nickname">{{userInfo.nickName || '微信用户'}}</view>
      <view class="phone">{{userInfo.phone || '未绑定手机号'}}</view>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goProfile">
      <text class="menu-icon">🗂️</text>
      <text class="menu-name">健康档案管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goReport">
      <text class="menu-icon">🧪</text>
      <text class="menu-name">检查指标解读</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goNotice">
      <text class="menu-icon">📄</text>
      <text class="menu-name">免责声明与隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="scope-note">
    本小程序仅提供健康初筛、导诊与科普解读，不提供诊断、处方或治疗方案。
  </view>

  <button class="logout-btn" bindtap="logout">退出登录</button>
</view>
