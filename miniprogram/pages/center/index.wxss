.page {
  padding: 32rpx 28rpx 60rpx;
}

.user-card {
  background: linear-gradient(135deg, #43A294, #62bfb1);
  border-radius: 22rpx;
  padding: 40rpx 36rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-info {
  margin-left: 26rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.phone {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.88);
}

.menu {
  margin-top: 26rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f0f4f3;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 38rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 29rpx;
  color: #2b3a37;
}

.menu-arrow {
  color: #c2ccc9;
  font-size: 40rpx;
}

.scope-note {
  margin: 26rpx 12rpx;
  font-size: 23rpx;
  color: #93a5a1;
  line-height: 1.7;
}

.logout-btn {
  margin-top: 10rpx;
  background: #fff;
  color: #d9534f;
  border-radius: 48rpx;
  font-size: 30rpx;
}

.logout-btn::after {
  border: none;
}
