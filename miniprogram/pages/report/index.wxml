<view class="page report-page">
  <!-- 解读结果 -->
  <view class="result-card" wx:if="{{interpretation}}">
    <view class="result-head">
      <view class="result-badge"><view class="ic ic-sm ic-spark"></view></view>
      <view class="result-title">AI 科普解读</view>
    </view>
    <view class="result-text">{{interpretation}}</view>
  </view>

  <!-- 基础信息 -->
  <view class="form-card">
    <view class="form-card-title">检查信息</view>
    <view class="form-row">
      <text class="form-label">就诊人</text>
      <picker class="flex1" range="{{profiles}}" range-key="realName" value="{{profileIndex}}" bindchange="onProfileChange">
        <view class="picker-value">{{profiles.length ? profiles[profileIndex].realName : '请先建档'}}<text class="caret">▾</text></view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">检查类型</text>
      <picker class="flex1" range="{{types}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-value">{{types[typeIndex]}}<text class="caret">▾</text></view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">检查日期</text>
      <picker class="flex1" mode="date" value="{{reportDate}}" bindchange="onDateChange">
        <view class="picker-value">{{reportDate}}<text class="caret">▾</text></view>
      </picker>
    </view>
  </view>

  <!-- 指标录入 -->
  <view class="form-card">
    <view class="form-card-title">
      检查指标
      <text class="card-hint">对照报告单填写，至少一项</text>
    </view>

    <view
      class="metric-row {{focusedIdx === index ? 'focus' : ''}}"
      wx:for="{{indicators}}"
      wx:key="index"
    >
      <input
        class="m-name {{item.custom ? 'editable' : ''}}"
        value="{{item.name}}"
        placeholder="指标名称"
        placeholder-class="m-placeholder"
        data-idx="{{index}}"
        bindinput="onIndicatorNameInput"
      />
      <view class="m-input-wrap">
        <input
          class="m-value"
          type="{{item.custom ? 'text' : 'digit'}}"
          value="{{item.value}}"
          placeholder="数值"
          placeholder-class="m-placeholder"
          data-idx="{{index}}"
          bindfocus="onMetricFocus"
          bindblur="onMetricBlur"
          bindinput="onIndicatorInput"
        />
        <text class="m-unit" wx:if="{{item.unit}}">{{item.unit}}</text>
      </view>
      <view wx:if="{{item.custom}}" class="m-del" data-idx="{{index}}" bindtap="removeIndicator">
        <view class="del-x"></view>
      </view>
    </view>

    <view class="add-ind" hover-class="add-hover" bindtap="addIndicator">
      <view class="ic ic-sm ic-plus add-ic"></view>
      <text>添加指标</text>
    </view>
  </view>

  <view class="form-tip disclaimer-mini">解读仅为科普参考，异常指标请到消化内科 / 肝病科就诊确认</view>

  <!-- 解读记录 -->
  <view class="section-head" wx:if="{{history.length}}">
    <text class="st-title">解读记录</text>
  </view>
  <view class="history-item" wx:for="{{history}}" wx:key="id">
    <view class="history-head" data-id="{{item.id}}" bindtap="toggleHistory">
      <view class="history-ic"><view class="ic ic-sm ic-doc"></view></view>
      <view class="history-info">
        <view class="history-type">{{item.typeLabel}}</view>
        <view class="history-date">{{item.reportDate}}</view>
      </view>
      <view class="history-arrow {{expandedId === item.id ? 'up' : ''}}"></view>
    </view>
    <view class="history-body" wx:if="{{expandedId === item.id}}">{{item.aiInterpretation}}</view>
  </view>

  <!-- 底部固定保存 -->
  <view class="footer-holder"></view>
  <view class="footer-bar">
    <button class="btn-primary submit-btn" loading="{{submitting}}" bindtap="onSubmit">生成 AI 科普解读</button>
  </view>
</view>
