.page {
  padding: 24rpx 28rpx 60rpx;
}

.result-card {
  background: linear-gradient(135deg, #e8f5f2, #f2faf8);
  border: 1rpx solid #bfe0d9;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2e8b7d;
}

.result-text {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: #3e5550;
  line-height: 1.75;
  white-space: pre-wrap;
}

.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 22rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f3a36;
  padding: 24rpx 0 4rpx;
}

.row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f0f4f3;
}

.row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #333;
  width: 180rpx;
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.ind-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f4f3;
}

.ind-name {
  flex: 1.3;
  font-size: 26rpx;
  color: #555;
  background: #f6f9f8;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}

.ind-name.editable {
  color: #333;
  background: #fff;
  border: 1rpx solid #d8e0de;
}

.ind-value {
  flex: 1;
  font-size: 26rpx;
  background: #f6f9f8;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}

.ind-del {
  width: 48rpx;
  text-align: center;
  color: #d9534f;
  font-size: 28rpx;
}

.add-ind {
  padding: 24rpx 0;
  text-align: center;
  color: #43A294;
  font-size: 27rpx;
}

.submit-btn {
  margin-top: 8rpx;
  background: #43A294;
  color: #fff;
  border-radius: 48rpx;
  font-size: 31rpx;
}

.submit-btn::after {
  border: none;
}

.tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #aab8b5;
}

.section-title {
  margin: 34rpx 8rpx 16rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: #1f3a36;
}

.history-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  padding: 22rpx 26rpx;
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b3a37;
}

.history-date {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #aab8b5;
}

.arrow {
  color: #9db2ad;
  font-size: 22rpx;
}

.history-body {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f4f3;
  font-size: 25rpx;
  color: #55645f;
  line-height: 1.7;
  white-space: pre-wrap;
}
