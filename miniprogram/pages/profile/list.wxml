<view class="page">
  <view class="hint">可为本人生成档案，也可帮父母/家属建立（最多按实际需要添加）</view>

  <view class="profile-card" wx:for="{{profiles}}" wx:key="id" data-id="{{item.id}}" bindtap="goEdit">
    <view class="card-head">
      <view class="name">{{item.realName}}</view>
      <view class="meta">{{item.relation}} · {{item.gender}} · {{item.age || '?'}}岁</view>
    </view>
    <view class="tags" wx:if="{{item.tags.length}}">
      <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>
    <view class="no-risk" wx:else>暂无高危因素标记</view>
    <view class="card-actions">
      <text class="del" catchtap="onDelete" data-id="{{item.id}}">删除</text>
    </view>
  </view>

  <view class="empty" wx:if="{{profiles.length === 0}}">
    <view class="empty-icon">🗂️</view>
    <view>还没有健康档案</view>
  </view>

  <button class="add-btn" bindtap="goCreate">+ 新建健康档案</button>
</view>
