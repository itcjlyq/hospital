/* 健康档案列表 */
.profile-list-page { padding-top: 24rpx; }

.page-title {
  padding: 0 8rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #183B4A;
}

.page-sub {
  padding: 10rpx 8rpx 30rpx;
  font-size: 24rpx;
  color: #84929F;
}

.card-hover { opacity: 0.85; }

.profile-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(24, 59, 74, 0.05);
}

.card-main {
  display: flex;
  gap: 24rpx;
}

.p-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #E8F7F4, #D7F1EC);
  color: #0B7F76;
  font-size: 38rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.p-info { flex: 1; min-width: 0; }

.name-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.name {
  font-size: 33rpx;
  font-weight: 700;
  color: #183B4A;
}

.relation-tag {
  font-size: 21rpx;
  color: #0B7F76;
  background: #E8F7F4;
  border-radius: 999rpx;
  padding: 5rpx 16rpx;
}

.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #84929F;
}

.tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #3A6EA0;
  background: #EAF3FA;
  border-radius: 999rpx;
  padding: 7rpx 18rpx;
}

.no-risk {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #A6B4BD;
}

.card-actions {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F4F2;
  text-align: right;
}

.del {
  font-size: 24rpx;
  color: #C9665E;
  padding: 6rpx 12rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
}

.add-plus {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}
.add-plus::before,
.add-plus::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: #FFFFFF;
  border-radius: 2rpx;
}
.add-plus::before {
  width: 28rpx;
  height: 3rpx;
  transform: translate(-50%, -50%);
}
.add-plus::after {
  width: 3rpx;
  height: 28rpx;
  transform: translate(-50%, -50%);
}
