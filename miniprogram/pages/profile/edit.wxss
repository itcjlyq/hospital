/* 健康档案编辑 */
.profile-edit-page { padding-bottom: 40rpx; }

.flex1 { flex: 1; }

.form-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 8rpx 28rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(24, 59, 74, 0.05);
}

.form-card-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #183B4A;
  padding: 28rpx 0 12rpx;
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #183B4A;
}

.caret {
  margin-left: 8rpx;
  color: #A6B4BD;
  font-size: 22rpx;
}

.input-ph { color: #AEBBC4; }

/* 性别分段控件 */
.gender-group {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.gender {
  min-width: 120rpx;
  text-align: center;
  padding: 14rpx 0;
  border: 1rpx solid #D8E0DE;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #5E6D78;
  background: #FFFFFF;
}

.seg-hover { opacity: 0.7; }

.gender.active {
  background: #E8F7F4;
  border-color: #13A89E;
  color: #0B7F76;
  font-weight: 600;
}

/* 开关行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 98rpx;
  border-bottom: 1rpx solid #F0F4F2;
}
.switch-row:last-of-type { border-bottom: none; }

.sw-label {
  font-size: 28rpx;
  color: #344054;
  padding-right: 20rpx;
}

/* 整行宽字段 */
.column-row {
  padding: 22rpx 0;
  border-top: 1rpx solid #F0F4F2;
}

.col-label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 27rpx;
  color: #5E6D78;
}

.col-input {
  font-size: 28rpx;
  color: #183B4A;
}

.col-textarea {
  width: 100%;
  min-height: 130rpx;
  font-size: 28rpx;
  color: #183B4A;
  line-height: 1.6;
}

/* 底部保存 */
.save-btn {
  height: 92rpx;
  line-height: 92rpx;
  font-size: 31rpx;
}

.privacy-tip { margin-top: 14rpx; }
