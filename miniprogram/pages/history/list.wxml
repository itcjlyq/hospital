<view class="page history-page has-tabbar">
  <view class="page-title">初筛记录</view>
  <view class="page-sub">按时间回看每次 AI 初筛的过程与建议</view>

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="tl-item" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="tl-rail">
        <view class="tl-dot skeleton"></view>
        <view class="tl-line"></view>
      </view>
      <view class="tl-card-sk skeleton" style="height:180rpx;"></view>
    </view>
  </block>

  <!-- 时间线 -->
  <view class="timeline" wx:elif="{{sessions.length}}">
    <view class="tl-item" wx:for="{{sessions}}" wx:key="id">
      <view class="tl-rail">
        <view class="tl-dot {{item.statusCls}}"></view>
        <view class="tl-line" wx:if="{{index < sessions.length - 1}}"></view>
      </view>
      <view
        class="tl-card"
        hover-class="card-hover"
        data-id="{{item.id}}"
        data-status="{{item.status}}"
        bindtap="openSession"
      >
        <view class="card-top">
          <view class="complaint">{{item.chiefComplaint}}</view>
          <view class="status {{item.statusCls}}">{{item.statusText}}</view>
        </view>
        <view class="card-bottom">
          <view class="risk" wx:if="{{item.riskText}}">
            <view class="risk-dot {{item.statusCls}}"></view>
            <text>{{item.riskText}}</text>
          </view>
          <view class="time">{{item.createTime}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loadError}}">
    <view class="empty-ic"><view class="ic ic-empty"></view></view>
    <view class="empty-title">还没有初筛记录</view>
    <view class="empty-sub">从首页发起一次 AI 症状初筛，报告将自动保存在这里</view>
    <view class="empty-btn" bindtap="goNew">发起初次初筛</view>
  </view>

  <!-- 异常状态 -->
  <view class="error-state" wx:else>
    <view class="err-title">记录加载失败</view>
    <view class="err-sub">请检查网络后重试</view>
    <view class="err-btn" bindtap="loadList">重新加载</view>
  </view>
</view>
