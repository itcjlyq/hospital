<view class="page">
  <view class="card" wx:for="{{sessions}}" wx:key="id" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="openSession">
    <view class="card-top">
      <view class="complaint">{{item.chiefComplaint}}</view>
      <view class="status {{item.statusCls}}">{{item.statusText}}</view>
    </view>
    <view class="card-bottom">
      <view class="risk" wx:if="{{item.riskText}}">风险：{{item.riskText}}</view>
      <view class="time">{{item.createTime}}</view>
    </view>
  </view>

  <view class="empty" wx:if="{{sessions.length === 0}}">
    <view class="empty-icon">📋</view>
    <view class="empty-text">还没有初筛记录</view>
    <view class="empty-sub">从首页发起一次 AI 症状初筛吧</view>
  </view>
</view>
