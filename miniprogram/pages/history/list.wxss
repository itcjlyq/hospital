.page {
  padding: 24rpx 28rpx 60rpx;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.complaint {
  flex: 1;
  font-size: 29rpx;
  color: #243834;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status.ongoing {
  background: #eef3fb;
  color: #3f6ea8;
}

.status.finished {
  background: #e8f5f2;
  color: #2e8b7d;
}

.status.emergency {
  background: #fdecea;
  color: #c83c31;
}

.card-bottom {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.risk {
  font-size: 24rpx;
  color: #c05a2d;
}

.time {
  font-size: 23rpx;
  color: #aab8b5;
}

.empty {
  padding-top: 160rpx;
  text-align: center;
  color: #aab8b5;
}

.empty-icon {
  font-size: 90rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 30rpx;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
}
