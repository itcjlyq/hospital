/* 初筛记录 · 时间线 */
.history-page { padding-top: 24rpx; }

.page-title {
  padding: 0 8rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #183B4A;
}

.page-sub {
  padding: 10rpx 8rpx 30rpx;
  font-size: 24rpx;
  color: #84929F;
}

.card-hover { opacity: 0.85; }

.timeline { padding-top: 4rpx; }

.tl-item {
  display: flex;
  align-items: stretch;
}

/* 左侧轨道 */
.tl-rail {
  width: 44rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-top: 34rpx;
  background: #B9C6CF;
  border: 5rpx solid #EDF2F4;
  box-sizing: content-box;
  z-index: 2;
}
.tl-dot.ongoing { background: #4E89C4; border-color: #E4EEF8; }
.tl-dot.finished { background: #13A89E; border-color: #DDF3EF; }
.tl-dot.emergency { background: #D6453B; border-color: #FBE7E5; }

.tl-line {
  flex: 1;
  width: 2rpx;
  background: #E8EDF0;
  margin: 8rpx 0;
}

.tl-card,
.tl-card-sk {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  margin: 0 0 20rpx 18rpx;
  box-shadow: 0 8rpx 30rpx rgba(24, 59, 74, 0.05);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.complaint {
  flex: 1;
  font-size: 29rpx;
  font-weight: 500;
  color: #183B4A;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.status {
  flex-shrink: 0;
  font-size: 21rpx;
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  line-height: 1.4;
}

.status.ongoing { background: #E4EEF8; color: #3A6EA0; }
.status.finished { background: #E8F7F4; color: #0B7F76; }
.status.emergency { background: #FBE7E5; color: #C5382F; }

.card-bottom {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0F4F2;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.risk {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #54636E;
}

.risk-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #B9C6CF;
}
.risk-dot.ongoing { background: #4E89C4; }
.risk-dot.finished { background: #13A89E; }
.risk-dot.emergency { background: #D6453B; }

.time {
  font-size: 22rpx;
  color: #9DABB4;
}

.tl-card-sk {
  border-radius: 24rpx;
}
